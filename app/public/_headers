# Fichier de configuration des en-têtes HTTP pour Cloudflare Pages
# Voir: https://developers.cloudflare.com/pages/platform/headers/

# Note: Les routes /api/published* sont gérées par le Cloudflare Worker
# qui ajoute les headers Cache-Control directement à la réponse.
# Ce fichier s'applique aux assets statiques uniquement.

# Les fichiers pédagogiques statiques : cache limité
/content/*
  Cache-Control: public, max-age=3600

# Les images : cache long terme
/images/*
  Cache-Control: public, max-age=31536000, immutable

# L'application shell : cache long terme (hachés)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# HTML : pas de cache (la PWA gère)
/*.html
  Cache-Control: no-cache, max-age=0, must-revalidate

# Service Worker : pas de cache
/sw.js
  Cache-Control: no-cache, max-age=0, must-revalidate

