# Fichier de configuration des en-têtes HTTP pour Cloudflare Pages
# Voir: https://developers.cloudflare.com/pages/platform/headers/

# Les fichiers de contenu publié : pas de cache du navigateur
/api/published*
  Cache-Control: no-cache, max-age=0, must-revalidate
  Pragma: no-cache

# Les fichiers pédagogiques : cache limité
/content/*
  Cache-Control: public, max-age=3600

# Les images : cache long terme
/images/*
  Cache-Control: public, max-age=31536000, immutable

# L'application shell : cache court avec revalidation
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# HTML : pas de cache (la PWA gère)
/*.html
  Cache-Control: no-cache, max-age=0, must-revalidate

# Service Worker : pas de cache
/sw.js
  Cache-Control: no-cache, max-age=0, must-revalidate
