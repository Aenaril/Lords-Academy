// api/auth/discord/login.ts
async function handleDiscordLoginInit(req, env) {
  if (req.method === "OPTIONS") {
    return new Response(null, { status: 204 });
  }
  if (req.method !== "GET") {
    return new Response(
      JSON.stringify(errorResponse("Method not allowed")),
      { status: 405 }
    );
  }
  try {
    const state = generateCsrfState();
    await storeCsrfState(env.DB, state);
    const clientId = env.DISCORD_CLIENT_ID;
    const redirectUri = env.DISCORD_OAUTH_REDIRECT_URI;
    const scopes = ["identify", "guilds.members.read"].join(" ");
    const authUrl = new URL("https://discord.com/api/oauth2/authorize");
    authUrl.searchParams.set("client_id", clientId);
    authUrl.searchParams.set("redirect_uri", redirectUri);
    authUrl.searchParams.set("response_type", "code");
    authUrl.searchParams.set("scope", scopes);
    authUrl.searchParams.set("state", state);
    const response = {
      ok: true,
      authUrl: authUrl.toString()
    };
    return new Response(JSON.stringify(response), {
      status: 200,
      headers: { "Content-Type": "application/json" }
    });
  } catch (err) {
    console.error("Discord login init error:", err);
    return new Response(
      JSON.stringify(errorResponse("Internal server error", 500)),
      { status: 500 }
    );
  }
}
