  }
  if (backend === "do") {
    if (!env.DRAFTS_DO) {
      throw new Error(
        "STORAGE_BACKEND=do (default) configured but DRAFTS_DO binding not found. Configure the binding in Cloudflare Dashboard \u2192 Pages Settings \u2192 Functions \u2192 Bindings. To use KV fallback, set STORAGE_BACKEND=kv."
      );
    }
    const idLabel = tutorialId ? ` [${tutorialId}]` : "";
