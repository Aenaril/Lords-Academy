    return json3({ tutorialId, status: tutorial.status });
  } catch (err) {
    console.error("Error getting tutorial status:", err);
    return json3({ error: "Erreur serveur" }, 500);
  }
}
async function handleGetAllTutorialStatuses(req, env) {
  if (!originAllowed3(req, env)) return json3({ error: "Origine refus\xE9e" }, 403);
  if (!csrfOk3(req)) return json3({ error: "CSRF" }, 403);
  const session = await readSession3(req, env);
  if (!session) {
    return json3({ error: "Non authentifi\xE9", ok: false }, 401, {
      "Cache-Control": "private, no-store"
    });
  }
  try {
    const indexPath = "app/public/content/index.json";
    const indexUrl = `https://raw.githubusercontent.com/${env.GITHUB_REPO}/${env.GITHUB_BRANCH}/${indexPath}`;
    let indexData;
    try {
      const indexRes = await fetch(indexUrl, { cache: "no-store" });
      if (!indexRes.ok) {
        console.error(`[Statuses] GitHub index unavailable: ${indexRes.status}`);
        return json3({
          error: "Index GitHub indisponible",
          ok: false
        }, 503, {
          "Cache-Control": "private, no-store"
        });
      }
      indexData = await indexRes.json();
    } catch (err) {
      console.error("[Statuses] GitHub fetch failed:", err);
      return json3({
        error: "Impossible de charger l'index",
        ok: false
      }, 503, {
        "Cache-Control": "private, no-store"
      });
    }
    const allTutorials = indexData.tutorials || [];
    let draftIds = /* @__PURE__ */ new Set();
    try {
      const indexKey = "private:adminTutorialIds";
      const indexRaw = await env.DRAFTS.get(indexKey);
      const draftIndex = indexRaw ? JSON.parse(indexRaw) : { tutorialIds: [] };
      draftIds = new Set(draftIndex.tutorialIds || []);
    } catch (err) {
      console.error("[Statuses] KV read failed:", err);
    }
    const result = mergeTutorialStatuses(allTutorials, draftIds);
    return json3({
      ok: true,
      tutorials: result,
      count: result.length
    }, 200, {
      "Cache-Control": "private, no-store"
    });
  } catch (err) {
    console.error("Error getting all tutorial statuses:", err);
    return json3({
      error: "Erreur serveur",
      ok: false
    }, 500, {
      "Cache-Control": "private, no-store"
    });
  }
}
async function handleSetTutorialStatus(req, env) {
  if (!originAllowed3(req, env)) return json3({ error: "Origine refus\xE9e" }, 403);
  if (!csrfOk3(req)) return json3({ error: "CSRF" }, 403);
  if (!await readSession3(req, env)) return json3({ error: "Non authentifi\xE9" }, 401);
  const body = await req.json().catch(() => null);
  const tutorialId = sanitizeId(body?.tutorialId);
  const newStatus = body?.newStatus;
  if (!tutorialId || !newStatus) {
    return json3({ ok: false, error: "Param\xE8tres invalides" }, 400);
  }
  const validStatuses = ["draft", "in_progress", "published", "unpublished", "coming-soon"];
  if (!validStatuses.includes(newStatus)) {
    return json3({ ok: false, error: `Statut invalide: ${newStatus}` }, 422);
  }
  try {
    const headers = {
      Authorization: `Bearer ${env.GITHUB_TOKEN}`,
      "User-Agent": "lma-pages-function",
      Accept: "application/vnd.github+json"
    };
    const indexPath = "app/public/content/index.json";
    const indexUrl = `https://api.github.com/repos/${env.GITHUB_REPO}/contents/${indexPath}`;
    const currentRes = await fetch(`${indexUrl}?ref=${env.GITHUB_BRANCH}`, { headers });
    if (!currentRes.ok) {
      return json3({ ok: false, error: "Index non trouv\xE9" }, 404);
    }
    const indexData = await currentRes.json();
    let indexContent = { tutorials: [] };
    try {
      const decoded = decodeURIComponent(escape(atob(indexData.content.replace(/\n/g, ""))));
      indexContent = JSON.parse(decoded);
    } catch {
      return json3({ ok: false, error: "Index corrompu" }, 422);
    }
    const tutorialIndex = (indexContent.tutorials || []).findIndex((t) => t.id === tutorialId);
    if (tutorialIndex === -1) {
      return json3({ ok: false, error: "Tutoriel non trouv\xE9 dans index" }, 404);
    }
    const oldStatus = indexContent.tutorials[tutorialIndex].status;
    if (newStatus === "published") {
      try {
