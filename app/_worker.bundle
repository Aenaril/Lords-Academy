  const result = await storage.delete(tutorialId);
  if (!result.ok) {
    return json3(result, 500);
  }
  return json3({ ok: true });
}
async function handlePublish(req, env) {
  if (!originAllowed3(req, env)) return json3({ error: "Origine refus\xE9e" }, 403);
  if (!csrfOk3(req)) return json3({ error: "CSRF" }, 403);
  if (!await readSession3(req, env)) return json3({ error: "Non authentifi\xE9" }, 401);
  const body = await req.json().catch(() => null);
  const tutorialId = sanitizeId(body?.tutorialId);
  if (!tutorialId) {
    return json3({ ok: false, error: "tutorialId invalide" }, 400);
  }
  const content = body?.content;
  if (!content || typeof content !== "object") {
    return json3({ ok: false, error: "Contenu manquant ou invalide" }, 400);
  }
  if (content.id !== tutorialId) {
    return json3({ ok: false, error: "L'ID du tutoriel ne correspond pas" }, 422);
  }
  if (!content.title?.trim()) {
    return json3({ ok: false, error: "Titre du tutoriel manquant" }, 422);
  }
  if (!content.category?.trim()) {
    return json3({ ok: false, error: "Cat\xE9gorie du tutoriel manquante" }, 422);
  }
  if (!Array.isArray(content.sections) || content.sections.length === 0) {
    return json3({ ok: false, error: "Au moins une section est requise" }, 422);
  }
  for (let i = 0; i < content.sections.length; i++) {
    const section = content.sections[i];
    if (!section || typeof section !== "object") {
      return json3({ ok: false, error: `Section ${i} invalide` }, 422);
    }
    if (typeof section.title !== "string" || !section.title.trim()) {
      return json3({ ok: false, error: `Section ${i} : titre manquant` }, 422);
    }
    if (typeof section.sourceSlide !== "number") {
      return json3({ ok: false, error: `Section ${i} : sourceSlide invalide` }, 422);
    }
    if (!Array.isArray(section.blocks) || section.blocks.length === 0) {
      return json3({ ok: false, error: `Section ${i} : au moins un bloc requis` }, 422);
    }
    for (let j = 0; j < section.blocks.length; j++) {
      const block = section.blocks[j];
      if (!block || !block.type || typeof block.type !== "string") {
        return json3({ ok: false, error: `Section ${i}, bloc ${j} : type manquant` }, 422);
      }
    }
  }
  if (!validateTutorial(content)) {
    return json3({ ok: false, error: "Structure tutoriel invalide" }, 400);
  }
  const path = `app/public/content/${tutorialId}.json`;
  const apiBase = `https://api.github.com/repos/${env.GITHUB_REPO}/contents/${path}`;
  const headers = {
    Authorization: `Bearer ${env.GITHUB_TOKEN}`,
    "User-Agent": "lma-pages-function",
    Accept: "application/vnd.github+json"
  };
  const current = await fetch(`${apiBase}?ref=${env.GITHUB_BRANCH}`, { headers });
  let sha;
  if (current.ok) sha = (await current.json()).sha;
  if (body.baseRevision && sha && body.baseRevision !== sha) {
    return json3({ ok: false, conflict: { serverRevision: sha } }, 409);
  }
  const contentB64 = btoa(unescape(encodeURIComponent(JSON.stringify(content, null, 2))));
  const commit = await fetch(apiBase, {
    method: "PUT",
    headers,
    body: JSON.stringify({
      message: `Publication tutoriel ${tutorialId} (R4) \u2014 ${(/* @__PURE__ */ new Date()).toISOString()}`,
      content: contentB64,
      branch: env.GITHUB_BRANCH,
      sha
    })
  });
  if (!commit.ok) return json3({ ok: false, error: "\xC9chec publication" }, 502);
  const result = await commit.json();
  try {
    await rebuildPublishedIndex(env);
  } catch (err) {
    console.error("Erreur lors de la reconstruction de l'index:", err);
    return json3({
      ok: true,
      revision: result.content?.sha,
      warning: "Tutoriel publi\xE9, mais la mise \xE0 jour du catalogue peut \xEAtre retard\xE9e."
    });
  }
  return json3({ ok: true, revision: result.content?.sha });
}
async function handleUpload(req, env) {
  if (!originAllowed3(req, env)) return json3({ error: "Origine refus\xE9e" }, 403);
  if (!csrfOk3(req)) return json3({ error: "CSRF" }, 403);
  if (!await readSession3(req, env)) return json3({ error: "Non authentifi\xE9" }, 401);
  const formData = await req.formData().catch(() => null);
  if (!formData) return json3({ ok: false, error: "FormData invalide" }, 400);
  const file = formData.get("file");
  if (!file) return json3({ ok: false, error: "Fichier manquant" }, 400);
  const allowedTypes = ["image/jpeg", "image/png", "image/webp", "image/gif"];
  if (!allowedTypes.includes(file.type)) {
    return json3({ ok: false, error: "Type d'image non support\xE9" }, 400);
  }
  const maxSize = 3 * 1024 * 1024;
  if (file.size > maxSize) {
    return json3({ ok: false, error: "Fichier trop volumineux" }, 400);
  }
  const bytes = await file.arrayBuffer();
  const base64 = btoa(String.fromCharCode(...new Uint8Array(bytes)));
  const ext = file.name.split(".").pop() || "png";
  const filename = `image-${Date.now()}.${ext}`;
  const path = `app/public/images/${filename}`;
  const headers = {
    Authorization: `Bearer ${env.GITHUB_TOKEN}`,
    "User-Agent": "lma-pages-function",
    Accept: "application/vnd.github+json"
  };
  const apiBase = `https://api.github.com/repos/${env.GITHUB_REPO}/contents/${path}`;
  const commitRes = await fetch(apiBase, {
    method: "PUT",
    headers,
    body: JSON.stringify({
      message: `Upload image ${filename} (R4) \u2014 ${(/* @__PURE__ */ new Date()).toISOString()}`,
      content: base64,
      branch: env.GITHUB_BRANCH
    })
  });
  if (!commitRes.ok) {
    return json3({ ok: false, error: "\xC9chec upload" }, 502);
  }
  const imageUrl = `https://raw.githubusercontent.com/${env.GITHUB_REPO}/${env.GITHUB_BRANCH}/${path}`;
  return json3({ ok: true, url: imageUrl });
}
function contentPath(tutorialId) {
  return `app/public/content/${tutorialId}.json`;
}
function ghHeaders(env) {
  return {
    Authorization: `Bearer ${env.GITHUB_TOKEN}`,
    "User-Agent": "lma-pages-function",
    Accept: "application/vnd.github+json"
  };
}
async function handleHistory(req, env, url) {
  if (!await readSession3(req, env)) return json3({ error: "Non authentifi\xE9" }, 401);
  const tutorialId = sanitizeId(url.searchParams.get("tutorialId"));
  if (!tutorialId) return json3({ error: "tutorialId invalide" }, 400);
  const path = contentPath(tutorialId);
  const cacheHeaders = {
    "Cache-Control": "no-cache, max-age=0, must-revalidate",
    "Pragma": "no-cache",
    "Expires": "0"
  };
  const PER_PAGE = 100;
  const MAX_PAGES = 20;
  const collected = [];
  try {
    for (let page = 1; page <= MAX_PAGES; page++) {
      const baseApi = `https://api.github.com/repos/${env.GITHUB_REPO}/commits?path=${encodeURIComponent(path)}&sha=${env.GITHUB_BRANCH}&per_page=${PER_PAGE}&page=${page}`;
      const api = `${baseApi}&t=${Date.now()}`;
      const res = await fetch(api, { headers: ghHeaders(env), cache: "no-store" });
      if (!res.ok) {
        if (page === 1) {
          console.error(`GitHub /commits API error for ${path}:`, res.status, res.statusText);
          return json3({ error: "Historique indisponible (erreur GitHub)" }, 502, cacheHeaders);
        }
        break;
      }
      const batch = await res.json();
      if (!Array.isArray(batch) || batch.length === 0) break;
      collected.push(...batch);
      if (batch.length < PER_PAGE) break;
    }
  } catch (err) {
    console.error("Error fetching history for", path, ":", err);
    if (collected.length === 0) {
      return json3({ error: "Historique indisponible (erreur r\xE9seau)" }, 502, cacheHeaders);
    }
    console.warn("Incomplete history retrieved for", path, "\u2014 returning", collected.length, "commits");
  }
  const entries = collected.map((c) => ({
    revision: c.sha,
    date: c.commit?.committer?.date ?? c.commit?.author?.date ?? "",
    message: c.commit?.message ?? "",
    authorLabel: "R4"
  })).sort((a, b) => {
    const ta = Date.parse(a.date) || 0;
    const tb = Date.parse(b.date) || 0;
    return tb - ta;
  });
  return json3({ tutorialId, entries }, 200, cacheHeaders);
}
async function handleVersion(req, env, url) {
  if (!await readSession3(req, env)) return json3({ error: "Non authentifi\xE9" }, 401);
  const tutorialId = sanitizeId(url.searchParams.get("tutorialId"));
  const revision = (url.searchParams.get("revision") ?? "").replace(/[^a-f0-9]/gi, "");
  if (!tutorialId || !revision) return json3({ error: "Param\xE8tres invalides" }, 400);
  const path = contentPath(tutorialId);
  const api = `https://api.github.com/repos/${env.GITHUB_REPO}/contents/${path}?ref=${revision}`;
  const res = await fetch(api, { headers: ghHeaders(env) });
  if (!res.ok) return json3({ error: "Version introuvable" }, 404);
  const data = await res.json();
  let content = null;
  try {
    const decoded = decodeURIComponent(escape(atob((data.content ?? "").replace(/\n/g, ""))));
    content = JSON.parse(decoded);
  } catch {
    content = null;
  }
  return json3({ revision, content });
}
async function handleRestore(req, env) {
  if (!originAllowed3(req, env)) return json3({ error: "Origine refus\xE9e" }, 403);
  if (!csrfOk3(req)) return json3({ error: "CSRF" }, 403);
  if (!await readSession3(req, env)) return json3({ error: "Non authentifi\xE9" }, 401);
  const body = await req.json().catch(() => null);
  const tutorialId = sanitizeId(body?.tutorialId);
  const revision = (body?.revision ?? "").replace(/[^a-f0-9]/gi, "");
  if (!tutorialId || !revision) return json3({ ok: false, error: "Param\xE8tres invalides" }, 400);
  const path = contentPath(tutorialId);
  const oldRes = await fetch(
    `https://api.github.com/repos/${env.GITHUB_REPO}/contents/${path}?ref=${revision}`,
    { headers: ghHeaders(env) }
  );
  if (!oldRes.ok) return json3({ ok: false, error: "Version introuvable" }, 404);
  const oldData = await oldRes.json();
  let parsed = null;
  try {
    parsed = JSON.parse(decodeURIComponent(escape(atob((oldData.content ?? "").replace(/\n/g, "")))));
  } catch {
    return json3({ ok: false, error: "Contenu de version illisible" }, 422);
  }
  if (!validateTutorial(parsed)) {
    return json3({ ok: false, error: "Version invalide (structure)" }, 422);
  }
  const headRes = await fetch(
    `https://api.github.com/repos/${env.GITHUB_REPO}/contents/${path}?ref=${env.GITHUB_BRANCH}`,
    { headers: ghHeaders(env) }
  );
  const currentSha = headRes.ok ? (await headRes.json()).sha : void 0;
  const commit = await fetch(
    `https://api.github.com/repos/${env.GITHUB_REPO}/contents/${path}`,
    {
      method: "PUT",
      headers: ghHeaders(env),
      body: JSON.stringify({
        message: `Restauration tutoriel ${tutorialId} depuis ${revision.slice(0, 7)} (R4) \u2014 ${(/* @__PURE__ */ new Date()).toISOString()}`,
        content: oldData.content,
        branch: env.GITHUB_BRANCH,
        sha: currentSha
      })
    }
  );
  if (!commit.ok) return json3({ ok: false, error: "\xC9chec restauration" }, 502);
  const result = await commit.json();
  return json3({ ok: true, revision: result.content?.sha });
}
function generateTutorialId(title, existingIds) {
  const base = title.toLowerCase().replace(/[éèê]/g, "e").replace(/[àâä]/g, "a").replace(/[ùû]/g, "u").replace(/[ôö]/g, "o").replace(/[îï]/g, "i").replace(/[ç]/g, "c").replace(/[^a-z0-9-]/g, "-").replace(/--+/g, "-").replace(/^-|-$/g, "").slice(0, 32);
  if (!existingIds.includes(base)) {
    return base;
  }
  const ts = Date.now().toString(36);
  return `${base}-${ts}`.slice(0, 48);
}
async function handleTutorialCreate(req, env) {
  if (!originAllowed3(req, env)) return json3({ error: "Origine refus\xE9e" }, 403);
  if (!csrfOk3(req)) return json3({ error: "CSRF" }, 403);
  if (!await readSession3(req, env)) return json3({ error: "Non authentifi\xE9" }, 401);
  const body = await req.json().catch(() => null);
  const title = (body?.title ?? "").trim();
  const category = (body?.category ?? "").trim();
  if (!title || !category) {
    return json3({ ok: false, error: "Titre et cat\xE9gorie requis" }, 400);
  }
  if (title.length > 100) {
    return json3({ ok: false, error: "Titre trop long (max 100 caract\xE8res)" }, 400);
  }
  try {
    const indexKey = "private:adminTutorialIds";
    let indexData = { tutorialIds: [], metadata: {} };
    if (env.DRAFTS) {
      try {
        const indexRaw = await env.DRAFTS.get(indexKey);
        if (indexRaw) indexData = JSON.parse(indexRaw);
      } catch {
      }
    }
    const existingIds = indexData.tutorialIds || [];
    const tutorialId = generateTutorialId(title, existingIds);
    const newTutorial = {
      id: tutorialId,
      title,
      description: "",
      category,
      difficulty: "easy",
      estimatedDuration: "10",
      coverIcon: "\u{1F4DA}",
      order: 999,
      status: "draft",
      sections: []
    };
    const storage = getStorageBackend(env, tutorialId);
    const saveResult = await storage.save(tutorialId, newTutorial);
    if (!saveResult.ok) {
      console.error("Failed to save draft:", saveResult);
      return json3({ ok: false, error: "Impossible d'enregistrer le brouillon" }, 500);
    }
    if (env.DRAFTS && !indexData.tutorialIds.includes(tutorialId)) {
      indexData.tutorialIds.push(tutorialId);
      indexData.metadata = indexData.metadata || {};
      indexData.metadata[tutorialId] = {
        createdAt: (/* @__PURE__ */ new Date()).toISOString(),
        title,
        adminEmail: null
      };
      try {
        await env.DRAFTS.put(indexKey, JSON.stringify(indexData));
      } catch (err) {
        console.error("Failed to update tutorial index:", err);
      }
    }
    return json3({
      ok: true,
      tutorialId,
      tutorial: newTutorial
    });
  } catch (err) {
    console.error("Error creating tutorial:", err);
    return json3({ ok: false, error: "Erreur serveur lors de la cr\xE9ation" }, 500);
  }
}
async function handleTutorialIds(req, env) {
  if (!await readSession3(req, env)) return json3({ error: "Non authentifi\xE9" }, 401);
  try {
    const indexKey = "private:adminTutorialIds";
    const indexRaw = await env.DRAFTS.get(indexKey);
    const indexData = indexRaw ? JSON.parse(indexRaw) : { tutorialIds: [], metadata: {} };
    const tutorialIds = indexData.tutorialIds || [];
    if (!tutorialIds.includes("dragon-arena")) {
      tutorialIds.unshift("dragon-arena");
    }
    return json3({
      ok: true,
      tutorialIds
    });
  } catch (err) {
    console.error("Error fetching tutorial IDs:", err);
    return json3({ ok: false, error: "Erreur serveur" }, 500);
  }
}
async function handlePublishedTutorials(req, env) {
  const cacheHeaders = {
    "Cache-Control": "public, max-age=60, must-revalidate, no-transform",
    "Pragma": "public"
  };
  try {
    const indexPath = "app/public/content/index.json";
    const indexUrl = `https://raw.githubusercontent.com/${env.GITHUB_REPO}/${env.GITHUB_BRANCH}/${indexPath}`;
    const indexRes = await fetch(indexUrl, { cache: "no-store" });
    if (!indexRes.ok) {
      console.warn(`Index publi\xE9 indisponible: ${indexRes.status}`);
      return json3({ tutorials: [] }, 200, cacheHeaders);
    }
    const indexData = await indexRes.json();
    const allTutorials = indexData.tutorials || [];
    const visibleTutorials = allTutorials.filter(
      (t) => t.status === "published" || t.status === "coming-soon"
    );
    return json3({ tutorials: visibleTutorials }, 200, cacheHeaders);
  } catch (err) {
    console.error("Error fetching published tutorials:", err);
    return json3({ tutorials: [] }, 200, cacheHeaders);
  }
}
async function handleGetPublished(req, env, url) {
  const tutorialId = sanitizeId(url.searchParams.get("tutorialId"));
  if (!tutorialId) return json3({ error: "tutorialId invalide" }, 400);
  try {
    const headers = {
      Authorization: `Bearer ${env.GITHUB_TOKEN}`,
      "User-Agent": "lma-pages-function",
      Accept: "application/vnd.github+json"
    };
    const indexPath = "app/public/content/index.json";
    const indexUrl = `https://raw.githubusercontent.com/${env.GITHUB_REPO}/${env.GITHUB_BRANCH}/${indexPath}`;
    const indexRes = await fetch(indexUrl, { cache: "no-store" });
    if (!indexRes.ok) {
      return json3({ error: "Index non trouv\xE9" }, 404);
    }
    const indexData = await indexRes.json();
    const tutorial = (indexData.tutorials || []).find((t) => t.id === tutorialId);
    if (!tutorial || tutorial.status !== "published") {
      return json3({ error: "Tutoriel non publi\xE9" }, 404);
    }
    const contentPath2 = `app/public/content/${tutorialId}.json`;
    const apiUrl = `https://api.github.com/repos/${env.GITHUB_REPO}/contents/${contentPath2}?ref=${env.GITHUB_BRANCH}`;
    const apiRes = await fetch(apiUrl, { headers, cache: "no-store" });
    let sha;
    if (apiRes.ok) {
      const apiData = await apiRes.json();
      sha = apiData.sha;
    }
    let contentUrl = `https://raw.githubusercontent.com/${env.GITHUB_REPO}/${env.GITHUB_BRANCH}/${contentPath2}`;
    if (sha) {
      contentUrl += `?v=${sha}`;
    }
    const contentRes = await fetch(contentUrl, { cache: "no-store" });
    if (!contentRes.ok) {
      return json3({ error: "Contenu non trouv\xE9" }, 404);
    }
    const content = await contentRes.json();
    return json3({ content, revision: sha || "published" }, 200, {
      "Cache-Control": "no-store"
    });
  } catch (err) {
    console.error("Error getting published tutorial:", err);
    return json3({ error: "Erreur serveur" }, 500);
  }
}
async function handleGetTutorialStatus(req, env, url) {
  if (!await readSession3(req, env)) return json3({ error: "Non authentifi\xE9" }, 401);
  const tutorialId = sanitizeId(url.searchParams.get("tutorialId"));
  if (!tutorialId) return json3({ error: "tutorialId invalide" }, 400);
