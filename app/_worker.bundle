function getStorageBackend(env, tutorialId) {
  const backend = (env.STORAGE_BACKEND ?? "do").toLowerCase();
  if (backend === "kv") {
    if (!env.DRAFTS) {
      throw new Error(
        "STORAGE_BACKEND=kv configured but DRAFTS KV binding not found. Configure the binding in Cloudflare Dashboard \u2192 Pages Settings \u2192 Functions \u2192 Bindings"
