    const indexRes = await fetch(indexUrl, { cache: "no-store" });
    if (!indexRes.ok) {
      return json3({ error: "Index non trouv\xE9" }, 404);
    }
    const indexData = await indexRes.json();
    const tutorial = (indexData.tutorials || []).find((t) => t.id === tutorialId);
    if (!tutorial) {
      return json3({ error: "Tutoriel non trouv\xE9" }, 404);
