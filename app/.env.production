# Configuration de production (Cloudflare Pages)
#
# Cette variable active l'administration sécurisée :
# - Le frontend accède à l'API via /api/* (Pages Functions)
# - Les sessions sont sécurisées par cookie HttpOnly
# - Les brouillons sont privés (KV)
# - La publication va vers GitHub

# API d'administration (Cloudflare Pages)
# Base URL SANS suffixe /api (les routes incluent déjà /api)
VITE_ADMIN_API_BASE="https://lords-academy.pages.dev"
